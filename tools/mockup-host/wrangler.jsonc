{
  "name": "oww-team-mockups",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-26",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    { "pattern": "owwpartners.site/mockups/*", "zone_name": "owwpartners.site" }
  ],
  "assets": {
    "directory": ".assets",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  }
}
